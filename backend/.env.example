# StudyMate AI backend configuration.
# Copy this file to `.env` (in the backend/ folder) and adjust the values.
# Never commit the real `.env` file: it may contain secrets.

# --- General -----------------------------------------------------------------
# development | production | test
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- AI provider -------------------------------------------------------------
# Which LLM backend to use: gemini (default, free tier) | openai | mock (deterministic, for tests)
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Model names. Check the provider's documentation: available models change over time.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini
# Sampling temperature for all generations (0.0 - 2.0). Low values keep answers grounded.
# (Some OpenAI reasoning models do not accept a temperature; it is then omitted automatically.)
LLM_TEMPERATURE=0.2
# Upper bound on the tokens generated per answer.
LLM_MAX_OUTPUT_TOKENS=4096
# Seconds to wait for the provider (per chunk when streaming) before giving up.
LLM_TIMEOUT_SECONDS=60
# Retries after a rate-limit, timeout or server error, with exponential backoff (1s, 2s, 4s, ...).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1

# --- Embeddings / RAG --------------------------------------------------------
# local (sentence-transformers, runs on your machine) | gemini | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Storage -----------------------------------------------------------------
# SQLite by default. For PostgreSQL use e.g. postgresql+psycopg://user:password@localhost:5432/studymate
DATABASE_URL=sqlite:///./data/studymate.db
# Persistent vector store (ChromaDB) and uploaded files. Relative paths resolve from where you start the server.
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
# Maximum size of an uploaded file, in megabytes.
MAX_UPLOAD_MB=25
# Maximum size of any other request body (JSON), in kilobytes.
MAX_JSON_BODY_KB=1024

# --- Security ----------------------------------------------------------------
# Password for the researcher/admin area. Leave empty to keep the admin area disabled.
ADMIN_PASSWORD=
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In-memory rate limit per client: at most RATE_LIMIT_REQUESTS requests per window (seconds).
# State lives in the process memory: with several worker processes each enforces its own limit.
# Behind a reverse proxy all clients share the proxy's address; limit at the proxy instead.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Feature flags (true | false) --------------------------------------------
# Server-side text-to-speech (Meta MMS-TTS). The browser voice is used when disabled.
FEATURE_SERVER_TTS=false
# Study Mode (controlled experiment flow and admin analytics).
FEATURE_STUDY_MODE=true
# Explainer Mode (avatar that teaches a document).
FEATURE_EXPLAINER_MODE=true
