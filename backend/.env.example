# MIK – StudyMate AI backend configuration.
# Copy this file to `.env` (in the backend/ folder) and adjust the values.
# Never commit the real `.env` file: it may contain secrets.

# --- General -----------------------------------------------------------------
# development | production | test
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- AI provider -------------------------------------------------------------
# Which LLM backend to use: gemini (default, free tier) | openai | mock (deterministic, for tests)
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Model names. Check the provider's documentation: available models change over time.
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4.1-mini
# Sampling temperature for all generations (0.0 - 2.0). Low values keep answers grounded.
# (Some OpenAI reasoning models do not accept a temperature; it is then omitted automatically.)
LLM_TEMPERATURE=0.2
# Upper bound on the tokens generated per answer.
LLM_MAX_OUTPUT_TOKENS=4096
# Seconds to wait for the provider (per chunk when streaming) before giving up.
LLM_TIMEOUT_SECONDS=60
# Retries after a rate-limit, timeout or server error, with exponential backoff (1s, 2s, 4s, ...).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1
# Caps how many LLM calls run at once across the whole process; extra callers queue instead of
# all firing at once. Keep this low on a small/free-tier server to avoid bursting past the
# provider's own rate limit or spiking memory.
LLM_MAX_CONCURRENT_REQUESTS=4
# Only for the Playwright e2e suite (LLM_PROVIDER=mock): path to a JSON file of
# {schema class name: response object} giving MockProvider realistic, deterministic answers.
# Leave unset for normal development and never set it in production.
MOCK_LLM_FIXTURES_PATH=

# --- Embeddings / RAG --------------------------------------------------------
# local (sentence-transformers, runs on your machine; downloaded on first use) | gemini | openai |
# hash. gemini/openai call that provider's embedding endpoint instead, so a small server can skip
# installing/downloading a local model entirely.
# The default local model (~470 MB on disk, ~1 GB RAM while loaded) downloads once to the
# Hugging Face cache the first time a document is indexed or a tutor question is asked.
# "hash" is a deterministic, dependency-free fallback with no real semantic understanding — only
# for tests and the Playwright e2e suite (paired with LLM_PROVIDER=mock); never use it in
# production.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Retrieval: FETCH_K nearest chunks are embedded and considered, then MMR re-ranks down to
# TOP_K, trading a little pure relevance for topical diversity (MMR_LAMBDA=1.0 disables that).
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_MMR_LAMBDA=0.5
# Prior tutor messages (user + assistant turns combined) replayed as conversation memory.
TUTOR_HISTORY_MESSAGES=6
# Topic mastery (0..1, an EWMA of quiz scores) classification for the mastery panel,
# weak-topic re-explanations, and the tutor's learner profile: weak < WEAK_THRESHOLD <
# developing < DEVELOPING_THRESHOLD < strong.
MASTERY_WEAK_THRESHOLD=0.5
MASTERY_DEVELOPING_THRESHOLD=0.75
# How much a new quiz answer shifts the running average (scaled further by question difficulty).
MASTERY_EWMA_ALPHA=0.3

# --- Storage -----------------------------------------------------------------
# SQLite by default. For PostgreSQL use e.g. postgresql+psycopg://user:password@localhost:5432/studymate
DATABASE_URL=sqlite:///./data/studymate.db
# Persistent vector store (ChromaDB) and uploaded files. Relative paths resolve from where you start the server.
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
# Maximum size of an uploaded file, in megabytes.
MAX_UPLOAD_MB=25
# Maximum size of any other request body (JSON), in kilobytes.
MAX_JSON_BODY_KB=1024

# --- Security ----------------------------------------------------------------
# Password for the researcher/admin area. Leave empty to keep the admin area disabled.
ADMIN_PASSWORD=
# How long a signed-in admin session stays valid before needing to log in again.
ADMIN_SESSION_HOURS=8
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In-memory rate limit per client: at most RATE_LIMIT_REQUESTS requests per window (seconds).
# State lives in the process memory: with several worker processes each enforces its own limit.
# Behind a reverse proxy all clients share the proxy's address; limit at the proxy instead.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Daily quotas per browser (anonymous id; per participant code in Study Mode), reset at the
# user's local midnight. Fair-use limits, not a security boundary. 0 disables one.
# AI requests = every call to the LLM provider, so the whole deployment stays within Gemini's
# free tier (1,500 requests/day). Usage rows are kept for analysis, never deleted automatically.
QUOTA_DAILY_GEMINI_REQUESTS=50
QUOTA_DAILY_UPLOADS=5

# --- Explainer Mode -----------------------------------------------------------
# Sectioning targets roughly this many words of source material per section (about a minute of
# speech), and never splits a document into more than this many sections.
EXPLAINER_TARGET_WORDS_PER_SECTION=220
EXPLAINER_MAX_SECTIONS=12
# Number of mini-quiz questions generated after each section (2 or 3).
EXPLAINER_MINI_QUIZ_QUESTIONS=3

# --- Feature flags (true | false) --------------------------------------------
# Server-side text-to-speech (Meta MMS-TTS models, via the `transformers` package) is the
# primary voice for the Avatar tab; the browser's speechSynthesis voice is only an automatic
# fallback when a model fails to load, times out, or the disk is full, so the avatar always
# still speaks either way. `transformers` is a plain requirements.txt dependency as of Phase
# 4c, so no extra install step is needed; the first synthesis request per language downloads
# that language's ~150-200 MB MMS-TTS model into HF_HOME (below), which takes a few minutes —
# every request after that, for any text already seen, is served instantly from TTS_CACHE_DIR.
FEATURE_SERVER_TTS=true
TTS_MODEL_SQ=facebook/mms-tts-sqi
TTS_MODEL_EN=facebook/mms-tts-eng
# Disk cache of synthesized audio, content-addressed by (text, language, model version) so a
# replay of the same section is instant. Capped at TTS_CACHE_MAX_MB; once exceeded, the oldest
# files are deleted until the cache is back under 80% of that cap.
TTS_CACHE_DIR=./data/tts_cache
TTS_CACHE_MAX_MB=500
# Hugging Face's model cache root (used by both MMS-TTS and the local embedding provider), kept
# inside the project rather than the default of the user's home directory.
HF_HOME=./data/hf_cache
# Study Mode (controlled experiment flow and admin analytics).
FEATURE_STUDY_MODE=true
# Explainer Mode (avatar that teaches a document).
FEATURE_EXPLAINER_MODE=true

# --- Study Mode ----------------------------------------------------------------
# See docs/STUDY_PROTOCOL.md for the full methodology. Block randomization keeps the two
# groups within STUDY_BLOCK_SIZE/2 of each other at every point (must be a positive even number).
STUDY_BLOCK_SIZE=4
# Length of the fixed study session before the frontend auto-transitions to the test.
STUDY_SESSION_MINUTES=20
STUDY_RETENTION_DELAY_DAYS=7
# Dev-only override: when set, the retention test unlocks this many MINUTES after the
# immediate test instead of STUDY_RETENTION_DELAY_DAYS. Leave unset in a real study.
STUDY_RETENTION_DELAY_DEV_MINUTES=
# Off by default: short-answer items are scored by the deterministic keyword rubric (see
# app/study/scoring.py). Turning this on additionally asks the LLM to score short answers,
# and that score becomes the recorded one — a deliberate methodological choice, so leave this
# off unless you specifically want AI-assisted grading as part of the study.
STUDY_LLM_ASSISTED_SCORING=false
